# Somente variáveis de servidor. Copie para .env.local e configure também na Vercel.
GITHUB_USERNAME=Jhowzxcv
# Token GitHub é opcional; use somente read-only para dados públicos.
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UUID do único usuário proprietário, criado em Authentication > Users.
OWNER_USER_ID=
RESEND_API_KEY=
# Sem domínio verificado, onboarding@resend.dev envia somente ao e-mail da conta Resend.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
CONTACT_TO=
